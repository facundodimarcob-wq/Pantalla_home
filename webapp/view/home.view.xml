<mvc:View
    controllerName="pantallahome.controller.home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout">
    
    <Page id="pageHome" showHeader="false" class="sapUiNoContentPadding">
        <content>
            <VBox id="rootVBox" height="100%" class="root-container">
                
                <Toolbar id="shellHeader" class="custom-shell-header">
                    <Image id="sapLogoImage" src="https://upload.wikimedia.org/wikipedia/commons/5/59/SAP_2011_logo.svg" height="28px" class="sapUiTinyMarginBegin sapUiSmallMarginEnd" />
                    <Text id="hisText" text="{i18n>shell.title}" class="sap-his-text" />
                    <ToolbarSpacer id="headerSpacer" />
                    <Button id="btnHome" icon="sap-icon://home" type="Transparent" tooltip="{i18n>tooltip.home}" class="shell-header-btn" />
                    <Button id="btnNotifications" icon="sap-icon://bell" type="Transparent" tooltip="{i18n>tooltip.notifications}" class="shell-header-btn" />
                    
                    <Button id="btnAI" icon="sap-icon://initiative" type="Transparent" press=".onOpenAIDialog" tooltip="Asistente IA" class="shell-header-btn" />
                    
                    <Button id="themeButton" icon="sap-icon://palette" type="Transparent" press=".onThemeMenuPress" tooltip="{i18n>tooltip.theme}" class="shell-header-btn" />
                    <Button id="btnSession" icon="sap-icon://log" type="Transparent" press=".onAvatarPress" tooltip="{i18n>tooltip.session}" class="shell-header-btn" />
                </Toolbar>

                <HBox id="mainAppHBox" width="100%" class="app-main-layout">
                    <layoutData>
                        <FlexItemData id="mainAppFlexData" growFactor="1" />
                    </layoutData>
                    
                    <VBox id="sidebarVBox" class="sidebar-container" width="280px">
                        <layoutData>
                            <FlexItemData id="sidebarFlexData" shrinkFactor="0" minWidth="280px" />
                        </layoutData>
                        
                        <HBox id="userInfoHBox" alignItems="Center" width="100%" class="sapUiSmallMarginBottom sapUiSmallMarginTop">
                            <Avatar id="sideAvatar" src="sap-icon://customer" displaySize="S" class="sapUiSmallMarginEnd" backgroundColor="Accent6" />
                            <VBox id="userNameVBox" width="100%">
                                <Text id="welcomeText" text="{i18n>sidebar.welcome}" wrapping="false" class="welcome-text" />
                                <Title id="userNameTitle" text="{userModel>/name}" level="H6" titleStyle="H6" wrapping="true" />
                            </VBox>
                        </HBox>
                        
                        <SearchField id="globalSearchField" width="100%" placeholder="{i18n>sidebar.searchPlaceholder}" liveChange=".onSearch" class="sapUiSmallMarginBottom custom-search-field" />
                        
                        <List id="sidebarList" 
                        items="{
                            path: 'sideMenu>/items', 
                            templateShareable: true 
                        }" 
                        class="sidebar-list" 
                        showSeparators="None" 
                        itemPress=".onSidebarItemPress">
                        
                        <StandardListItem 
                            id="sidebarItem" 
                            title="{sideMenu>title}" 
                            icon="{sideMenu>icon}" 
                            type="Navigation"
                            class="{= ${sideMenu>active} ? 'active-menu-item' : '' }" />
                    </List>
                    </VBox>

                    <VBox id="mainContentVBox" class="main-content-container">
                        <layoutData>
                            <FlexItemData id="mainContentFlexData" growFactor="1" />
                        </layoutData>
                        
                        <VBox id="workzoneContainer" class="workzone-container">
                            <Title id="groupTitle" text="{i18n>workzone.title}" level="H2" titleStyle="H3" class="sapUiSmallMarginBottom sapUiTinyMarginBegin" />

                            <FlexBox id="tilesFlexBox" wrap="Wrap" justifyContent="Start" alignItems="Start" items="{domainModel>/Tiles}">
                                <GenericTile id="domainTile" header="{domainModel>title}" subheader="{i18n>workzone.tileSubheader}" press=".onTilePress" frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                    <TileContent id="domainTileContent">
                                        <NumericContent id="domainNumericContent" value="{domainModel>count}" icon="{domainModel>icon}" valueColor="Neutral" />
                                    </TileContent>
                                </GenericTile>
                            </FlexBox>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
<mvc:View
    controllerName="pantallahome.controller.home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout">
    
    <Page id="pageHome" showHeader="false" class="sapUiNoContentPadding">
        <content>
            <HBox id="mainAppHBox" width="100%" height="100%" class="app-main-layout">
                
                <VBox id="sidebarVBox" class="sidebar-container" width="320px">
                    <Title id="sidebarLogo" text="QASystems" titleStyle="H2" class="pantu-logo sapUiMediumMarginBottom" />
                    
                    <HBox id="userInfoHBox" alignItems="Center" class="sapUiSmallMarginBottom">
                        <Avatar id="sideAvatar" src="sap-icon://customer" displaySize="M" class="sapUiSmallMarginEnd" backgroundColor="Accent6" />
                        <VBox id="userNameVBox">
                            <Text id="welcomeText" text="Bienvenido(a)" class="welcome-text" />
                            <Title id="userNameTitle" text="{userModel>/name}" level="H5" titleStyle="H6" wrapping="true" />
                        </VBox>
                    </HBox>
                    
                    <SearchField 
                        id="globalSearchField"
                        width="100%" 
                        placeholder="Buscar..." 
                        liveChange=".onSearch" 
                        class="sapUiSmallMarginBottom custom-search-field" />
                    
                    <List id="sidebarList" items="{sideMenu>/items}" class="sidebar-list" showSeparators="None">
                        <StandardListItem 
                            id="sidebarListItem"
                            title="{sideMenu>title}" 
                            icon="{sideMenu>icon}" 
                            type="Navigation"
                            class="{= ${sideMenu>active} ? 'active-menu-item' : '' }" />
                    </List>
                </VBox>

                <VBox id="mainContentVBox" class="main-content-container">
                    <layoutData>
                        <FlexItemData id="mainContentFlexData" growFactor="1" />
                    </layoutData>
                    
                    <Toolbar id="topToolbar" design="Transparent" class="top-quick-toolbar sapUiSmallMarginBottom">
                        <ToolbarSpacer id="topToolbarSpacer" />
                        <Button id="btnHome" icon="sap-icon://home" type="Transparent" tooltip="Inicio" />
                        <Button id="btnNotifications" icon="sap-icon://bell" type="Transparent" tooltip="Notificaciones" />
                        <Button id="themeButton" icon="sap-icon://palette" type="Transparent" press=".onToggleDarkMode" tooltip="Cambiar Tema" />
                        <Button id="btnSession" icon="sap-icon://log" type="Transparent" press=".onAvatarPress" tooltip="Opciones de Sesión" />
                    </Toolbar>

                    <VBox id="workzoneContainer" class="workzone-container">
                        <Title id="groupTitle" text="Operaciones Centrales" level="H2" titleStyle="H3" class="sapUiSmallMarginBottom sapUiTinyMarginBegin" />

                        <FlexBox 
                            id="tilesFlexBox"
                            wrap="Wrap" 
                            justifyContent="Start" 
                            alignItems="Start" 
                            items="{domainModel>/Tiles}">
                            
                            <GenericTile
                                id="domainTile"
                                header="{domainModel>title}"
                                subheader="Funcionalidades"
                                press=".onTilePress"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <TileContent id="domainTileContent">
                                    <NumericContent
                                        id="domainNumericContent"
                                        value="{domainModel>count}"
                                        icon="{domainModel>icon}" 
                                        valueColor="Neutral" />
                                </TileContent>
                            </GenericTile>
                            
                        </FlexBox>
                    </VBox>
                </VBox>
            </HBox>
        </content>
    </Page>
</mvc:View>